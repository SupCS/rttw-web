PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rttw
# Railway: reference the PostgreSQL service DATABASE_URL in API variables.
# Opaque authentication tokens require no shared signing secret.
# The browser and /api reverse proxy use one origin; CORS is not enabled.
# In production use the exact HTTPS website origin and NODE_ENV=production.
WEB_ORIGIN=http://localhost:5173
# NODE_ENV=production
# Local development without PostgreSQL: npm run api:local (persistent .local-data).

