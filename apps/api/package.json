{
  "name": "@rttw/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "dev:local": "node --import tsx src/dev-server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env dist/database/migrate.js",
    "db:migrate:dev": "node --env-file-if-exists=.env --import tsx src/database/migrate.ts"
  },
  "engines": { "node": ">=22.13" },
  "dependencies": {
    "@rttw/domain": "0.1.0",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.7",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5"
  }
}
